<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- This is a TV-first app: leanback is required, touchscreen is optional. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <application
        android:name=".SiloTvApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SiloTv"
        android:usesCleartextTraffic="true">

        <!-- singleTask: warm launcher clicks (Watch Next tiles, pairing links)
             re-deliver their Uri to the live Activity via onNewIntent instead
             of stacking a second MainTvActivity on the task. -->
        <activity
            android:name=".MainTvActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SiloTv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- TV launchers use LEANBACK_LAUNCHER instead of LAUNCHER. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Device-pairing links from the `silo` scheme (e.g.
                     silo://device?token=…) so a QR/login flow on another
                     device can hand off to this TV for approval. -->
                <data android:scheme="silo" />
            </intent-filter>
        </activity>

        <!-- Debug-only adb test hook (scripts/android-playback-test.sh): status as
             JSON + transport commands via `am broadcast`. Sender must hold
             android.permission.DUMP (shell only); the receiver additionally
             no-ops in release builds. -->
        <receiver
            android:name="org.siloserver.silo.common.player.debug.PlaybackDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.siloserver.silo.debug.PLAYBACK_STATUS" />
                <action android:name="org.siloserver.silo.debug.PLAYBACK_COMMAND" />
            </intent-filter>
        </receiver>

        <!-- Media3 documents this as an exported service so system media
             controllers can discover and bind to the app session. -->
        <service
            android:name="org.siloserver.silo.common.player.SiloPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Disable WorkManager's androidx.startup auto-init so our explicit
             `WorkManager.initialize(this, workManagerConfiguration)` call in
             SiloTvApplication.onCreate wins with TvWorkerFactory wired
             in. Otherwise auto-init runs first with the default reflection
             factory and WatchNextSyncWorker can never be instantiated. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
